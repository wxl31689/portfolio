<view class="cart-page">
  <view wx:if="{{cart.length === 0}}" class="empty">
    购物车为空，请先选择菜品
  </view>

  <view wx:else>
    <view class="cart-item" wx:for="{{cart}}" wx:key="id">
      <view class="info">
        <view class="name">{{item.name}}</view>
        <view class="price">￥{{item.price}}</view>
      </view>

      <view class="count-box">
        <button size="mini" data-index="{{index}}" bindtap="reduceCount">-</button>
        <text class="count">{{item.quantity}}</text>
        <button size="mini" data-index="{{index}}" bindtap="addCount">+</button>
      </view>
    </view>

    <view class="remark-box">
      <textarea 
        placeholder="请输入备注，如少辣、不要香菜"
        value="{{remark}}"
        bindinput="onRemarkInput"
      ></textarea>
    </view>

    <view class="bottom-bar">
      <view class="total">合计：￥{{totalPrice}}</view>
      <button class="submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitOrder">
        {{submitting ? '处理中' : '提交并支付'}}
      </button>
    </view>
  </view>
</view>
