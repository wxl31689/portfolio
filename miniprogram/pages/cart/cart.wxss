.cart-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 164rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 92% 6%, rgba(255, 219, 147, 0.34) 0, rgba(255, 219, 147, 0) 34%),
    linear-gradient(180deg, #fff7e8 0%, #fff3e0 42%, #fff7ee 100%);
}

.empty {
  text-align: center;
  color: #9d8e7f;
  margin-top: 260rpx;
  font-size: 30rpx;
  background: rgba(255, 253, 248, 0.95);
  border-radius: 24rpx;
  padding: 56rpx 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(124, 11, 19, 0.08);
}

.cart-item {
  background: rgba(255, 253, 248, 0.97);
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 10rpx 24rpx rgba(124, 11, 19, 0.08);
  border: 1rpx solid rgba(255, 230, 188, 0.7);
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2b2118;
}

.price {
  margin-top: 10rpx;
  color: #d81e06;
  font-weight: bold;
}

.count-box {
  display: flex;
  align-items: center;
}

.count-box button {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  background: linear-gradient(180deg, #bc1a25 0%, #92111b 100%);
  color: #fff;
  border-radius: 50%;
  box-shadow: 0 8rpx 14rpx rgba(146, 17, 27, 0.25);
  font-size: 32rpx;
}

.count {
  margin: 0 22rpx;
  font-size: 30rpx;
  color: #2b2118;
  min-width: 40rpx;
  text-align: center;
}

.remark-box {
  background: rgba(255, 253, 248, 0.97);
  border-radius: 22rpx;
  padding: 22rpx;
  margin-top: 30rpx;
  box-shadow: 0 10rpx 24rpx rgba(124, 11, 19, 0.08);
  border: 1rpx solid rgba(255, 230, 188, 0.7);
}

textarea {
  width: 100%;
  height: 176rpx;
  font-size: 28rpx;
  color: #2b2118;
}

.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  height: 114rpx;
  background: rgba(255, 253, 248, 0.98);
  border-radius: 58rpx;
  border: 1rpx solid rgba(255, 230, 188, 0.7);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18rpx 0 26rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 34rpx rgba(124, 11, 19, 0.2);
}

.total {
  font-size: 30rpx;
  color: #d81e06;
  font-weight: bold;
}

.submit-btn {
  width: 226rpx;
  height: 74rpx;
  line-height: 74rpx;
  background: linear-gradient(180deg, #bc1a25 0%, #92111b 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
