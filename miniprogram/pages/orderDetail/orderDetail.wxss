.detail-page {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

.order-card,
.item-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
  color: #555;
}

.status {
  color: #d81e06;
  font-weight: bold;
}

.price {
  color: #d81e06;
  font-weight: bold;
}

.remark {
  margin-top: 20rpx;
  color: #666;
  line-height: 1.6;
}

.dish-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
}

.dish-name {
  font-size: 30rpx;
  color: #333;
}

.dish-price {
  margin-top: 8rpx;
  color: #888;
  font-size: 24rpx;
}

.subtotal {
  color: #d81e06;
  font-weight: bold;
}

.back-btn {
  margin-top: 20rpx;
  height: 86rpx;
  line-height: 86rpx;
  background: #d81e06;
  color: #fff;
  border-radius: 43rpx;
}

.pay-btn {
  margin-top: 40rpx;
  height: 86rpx;
  line-height: 86rpx;
  background: #0bbf5f;
  color: #fff;
  border-radius: 43rpx;
}
